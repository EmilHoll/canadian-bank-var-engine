dplyr::glimpse(asset_returns)
dplyr::glimpse(portfolio_returns)
head(portfolio_returns)
colSums(
is.na(portfolio_returns)
)
first_return_date <- min(
portfolio_returns$date
)
portfolio_return_contributions |>
dplyr::filter(
date == first_return_date
) |>
dplyr::select(
ticker,
weight,
simple_return,
weighted_return_contribution
)
portfolio_return_contributions |>
dplyr::filter(
date == first_return_date
) |>
dplyr::summarise(
manual_portfolio_return =
sum(
weighted_return_contribution
)
)
portfolio_returns |>
dplyr::filter(
date == first_return_date
) |>
dplyr::select(
date,
portfolio_simple_return
)
